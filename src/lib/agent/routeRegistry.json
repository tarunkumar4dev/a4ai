  "version": 1,
  "note": "ONE typed route registry for 'open this feature' (voice + text). Canonical copy: RAG-BACKEND/agent/routes/registry.json; the frontend copy src/lib/agent/routeRegistry.json is refreshed with `npm run agent:routes` and must be byte-identical. Keys are what the backend tool open_feature accepts (role-gated); the frontend executes ONLY keys in its copy, building the URL from path + query + typed params. `deep_link: false` = the page opens but cannot be told which tab/item to show (the tab is React state, not a URL param) — listed in the report.",
  "param_types": {
    "uuid": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "class": "^(?:[1-9]|1[0-2])$",
    "subject": "^[A-Za-z][A-Za-z ]{1,30}$",
    "view": "^(?:copies)$"
  },
