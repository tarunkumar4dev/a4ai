# a4ai Agent (local dev). Copy to .env.local.
# Agent backend base URL (RAG-BACKEND: ./scripts/run_agent_dev.sh serves http://localhost:8000).
VITE_AGENT_URL=http://localhost:8000
# Dev only: send X-Dev-Role (admin | teacher) instead of needing a real login. Ignored in production builds
# (only sent under `vite dev`) and by the backend unless AGENT_DEV_MODE=1. Leave empty to use your Supabase login.
VITE_AGENT_DEV_ROLE=
